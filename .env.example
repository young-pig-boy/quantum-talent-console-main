# ============================================================================
# Quantum Talent Console — Environment Variables (example)
# ============================================================================
# Copy this file to `.env.local` and fill in real values.
# NEVER commit real keys. All values below are placeholders.
#
# Formal Supabase project ref: wbpnvbvdotkjhwxhndhz
#   URL format: https://<project-ref>.supabase.co
#
# ⚠️ 禁止回连历史开发库 br-rapid-bram-8365a7da
# ============================================================================

# --- Supabase (client + server) --------------------------------------------
# Public URL of the Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://wbpnvbvdotkjhwxhndhz.supabase.co

# Publishable (anon) key — safe to expose in browser.
# Resolution order: NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY → NEXT_PUBLIC_SUPABASE_ANON_KEY → COZE_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Service Role key — SERVER ONLY. Never expose to the client bundle.
# Resolution order: SUPABASE_SECRET_KEY → SUPABASE_SERVICE_ROLE_KEY → COZE_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Break-glass Super Admin (server-only) ----------------------------------
# Super Admin login is independent of Supabase Auth.
# Authentication: username + scrypt password → HMAC signed HttpOnly cookie.
#
# Username for the break-glass super admin account.
SUPER_ADMIN_USERNAME=your-super-admin-username

# Pre-computed scrypt hash of the super admin password.
# Format: scrypt:<salt>:<hash>
# Generate with: node -e "const {hashPassword}=require('./dist/password'); console.log(hashPassword('YOUR_PASSWORD'))"
SUPER_ADMIN_PASSWORD_HASH=scrypt:your-salt:your-hash

# HMAC signing secret for access tokens.
# Production MUST set this. Do not use the development default.
LOCAL_ACCESS_SECRET=your-hmac-signing-secret

# Real profile UUID for the break-glass super admin actor.
# This should match a valid profiles.id in the formal Supabase.
# Resolution order: CONSOLE_ACTOR_ID → SUPER_ADMIN_ACTOR_ID → dev fallback
CONSOLE_ACTOR_ID=00000000-0000-0000-0000-000000000000

# Break-glass session lifetime in seconds (default: 86400 = 24 hours).
# BREAK_GLASS_SESSION_TTL_SECONDS=86400

# --- Coze Sandbox Aliases (optional, auto-injected) -------------------------
# The app falls back to these names if the standard vars are unset.
# COZE_SUPABASE_URL=
# COZE_SUPABASE_ANON_KEY=
# COZE_SUPABASE_SERVICE_ROLE_KEY=

# --- Runtime (platform-managed, do not hardcode) ----------------------------
# DEPLOY_RUN_PORT=5000
# COZE_PROJECT_ENV=DEV   # DEV | PROD
